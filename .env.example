# Copy this file to .env. Never commit real API credentials.
# Current backend adapter: Groq. Other providers are not enabled yet.
LLM_PROVIDER=groq
GROQ_API_KEY=replace_me

# Text and vision models available to your Groq account.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Offline fallback: Groq remains primary; local Qwen is loaded only after a recoverable outage.
HOMER_OFFLINE_FALLBACK=true
# Download once while online with: python -m app.ai.offline_model download
# Default model path: %USERPROFILE%\\.homer\\models\\qwen2.5-0.5b-instruct-q4_0.gguf
# HOMER_OFFLINE_MODEL_PATH=
HOMER_OFFLINE_CONTEXT=1536
HOMER_OFFLINE_THREADS=2
HOMER_OFFLINE_MAX_TOKENS=256

# Chat generation controls.
# Temperature: 0.0 (more deterministic) to 2.0 (more varied).
GROQ_TEMPERATURE=0.2
# Top-p: 0.0 to 1.0. Keep at 1.0 unless you intentionally tune sampling.
GROQ_TOP_P=1.0
# Reasoning depth for supported chat models: low, medium, or high.
GROQ_REASONING_EFFORT=medium
# Maximum generated tokens per provider response (includes model reasoning tokens).
GROQ_MAX_OUTPUT_TOKENS=2048

# Provider reliability controls.
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2

# HOMER chat context and request limits.
HOMER_CHAT_HISTORY_MESSAGES=12
HOMER_MAX_MESSAGE_CHARS=2000

# Optional local audio transcription controls (faster-whisper).
# HOMER_WHISPER_MODEL=tiny
# HOMER_WHISPER_THREADS=2

# Optional local globe UI URL (must remain localhost).
# HOMER_GLOBE_URL=http://127.0.0.1:4173

# Local SQLite RAG index and document folder (no cloud vector DB required).
# HOMER_KNOWLEDGE_DIR=
# HOMER_KNOWLEDGE_DB=

# Local CPU speech recognition; base balances speed and accuracy on 8 GB RAM.
HOMER_WHISPER_MODEL=base
HOMER_WHISPER_THREADS=4
HOMER_WHISPER_LANGUAGE=en

# Windows text-to-speech speed multiplier (0.75–2.00; default 1.50x).
HOMER_TTS_SPEED=1.50

# Dedicated visible Chromium profile used by HOMER browser automation.
# HOMER_BROWSER_PROFILE=
