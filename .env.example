# Copy this file to .env and add your own Groq API key.
# Never commit .env to Git.
GROQ_API_KEY=replace_me
# Model IDs can change or have account-specific availability. Choose one enabled for your account.
GROQ_MODEL=openai/gpt-oss-20b

# Hosted vision model for the opt-in screenshot feature (must support image input).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
